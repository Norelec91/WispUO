<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ClassicUO.Launcher"
        x:Class="ClassicUO.Launcher.MainWindow"
        Title="WispUO"
        Icon="/Assets/cuoicon.ico"
        Width="420" Height="400"
        MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="20">

    <!-- what this is and what it is built on: WispUO, ClassicUO, ClassicAssist -->
    <TextBlock x:Name="AboutText" DockPanel.Dock="Bottom" Margin="0,12,0,0"
               FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Quit" Click="OnQuit" MinWidth="90" HorizontalContentAlignment="Center" />
        <Button x:Name="PlayButton" Content="Play" Click="OnPlay" IsDefault="True"
                Classes="accent" MinWidth="110" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>

    <Grid>

      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Shards" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
          <Button Content="Add…" Click="OnAddShard" />
          <Button x:Name="EditButton" Content="Edit…" Click="OnEditShard" />
          <Button x:Name="DeleteButton" Content="Delete" Click="OnDeleteShard" />
        </StackPanel>

        <Border BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <Panel>
            <ListBox x:Name="ShardList"
                     SelectionMode="Single"
                     SelectionChanged="OnShardSelectionChanged"
                     DoubleTapped="OnShardDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:Shard">
                  <StackPanel Margin="0,2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.7" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyListText"
                       Text="No shards yet: add one to start playing."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="20"
                       Opacity="0.6" IsHitTestVisible="False" />
          </Panel>
        </Border>
      </DockPanel>

    </Grid>
  </DockPanel>
</Window>
