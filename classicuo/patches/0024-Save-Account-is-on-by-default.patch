 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/ClassicUO.Client/Configuration/Settings.cs b/src/ClassicUO.Client/Configuration/Settings.cs
index 32343aaa3..bdff3a70c 100644
--- a/src/ClassicUO.Client/Configuration/Settings.cs
+++ b/src/ClassicUO.Client/Configuration/Settings.cs
@@ -63,7 +63,7 @@ namespace ClassicUO.Configuration
 
         [JsonPropertyName("is_win_maximized")] public bool IsWindowMaximized { get; set; } = true;
 
-        [JsonPropertyName("saveaccount")] public bool SaveAccount { get; set; }
+        [JsonPropertyName("saveaccount")] public bool SaveAccount { get; set; } = true;
 
         [JsonPropertyName("autologin")] public bool AutoLogin { get; set; }
 
