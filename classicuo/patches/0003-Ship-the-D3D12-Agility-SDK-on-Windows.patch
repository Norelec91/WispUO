From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alessandro Lopez <norelec@gmail.com>
Date: Tue, 6 Oct 2026 08:58:13 +0200
Subject: [PATCH] Ship the D3D12 Agility SDK on Windows

SDL loads it as a vendored D3D12Core.dll from a D3D12 folder next to the
executable, which FNA3D points at; the client copies it there on build and
publish.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LFcBNQtF3Z7vfzi99BXwUe
---
 src/ClassicUO.Client/ClassicUO.Client.csproj | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/ClassicUO.Client/ClassicUO.Client.csproj b/src/ClassicUO.Client/ClassicUO.Client.csproj
index 9ad64c3c8..3fe18429a 100644
--- a/src/ClassicUO.Client/ClassicUO.Client.csproj
+++ b/src/ClassicUO.Client/ClassicUO.Client.csproj
@@ -92,6 +92,11 @@
     <DataFiles_win Include="$(ProjectDir)..\..\external\$(_WindowsNativeDir)\*.*" />
     <DataFiles_linux Include="$(ProjectDir)..\..\external\$(_LinuxNativeDir)\*.*" />
     <DataFiles_osx Include="$(ProjectDir)..\..\external\osx\*.*" />
+
+    <!-- The Agility SDK, which SDL loads explicitly as a "vendored D3D12Core.dll"
+         and FNA3D points at with .\D3D12\. It has to sit next to the executable,
+         so it keeps its own folder instead of being flattened. -->
+    <DataFiles_d3d12 Include="$(ProjectDir)..\..\external\x64\D3D12\*.*" />
   </ItemGroup>
 
   <ItemGroup>
@@ -104,6 +109,7 @@
     <Copy SourceFiles="@(DataFiles_win)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'$(_IsWindows)' == 'true'" />
     <Copy SourceFiles="@(DataFiles_linux)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'$(_IsLinux)' == 'true'" />
     <Copy SourceFiles="@(DataFiles_osx)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'$(_IsMacOS)' == 'true'" />
+    <Copy SourceFiles="@(DataFiles_d3d12)" DestinationFolder="$(OutputPath)\D3D12\" SkipUnchangedFiles="true" Condition="'$(_IsWindows)' == 'true'" />
   </Target>
 
   <Target Name="CopyExternalDeps_publish" AfterTargets="Publish">
@@ -114,6 +120,7 @@
     <Copy SourceFiles="@(DataFiles_win)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(_IsWindows)' == 'true'" />
     <Copy SourceFiles="@(DataFiles_linux)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(_IsLinux)' == 'true'" />
     <Copy SourceFiles="@(DataFiles_osx)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'$(_IsMacOS)' == 'true'" />
+    <Copy SourceFiles="@(DataFiles_d3d12)" DestinationFolder="$(PublishDir)\D3D12\" SkipUnchangedFiles="true" Condition="'$(_IsWindows)' == 'true'" />
 
     <Copy SourceFiles="@(MonockickstartPath)" DestinationFolder="$(PublishDir)\" SkipUnchangedFiles="true" Condition="'$(_IsLinux)' == 'true' Or '$(_IsMacOS)' == 'true'" />
 
