+# Paths are derived from this script's own location, so it runs from anywhere.
+script_dir="$(cd -P -- "$(dirname -- "$0")" && pwd -P)"
+root_dir="$(dirname "$script_dir")"
+
+client_project="$root_dir/src/ClassicUO.Client"
+launcher_project="$root_dir/src/ClassicUO.Launcher"
+plugin_host_project="$root_dir/src/ClassicUO.PluginHost"
+output_directory="$root_dir/bin/dist"
 target=""
 
+# The architecture follows the machine, and can be overridden with --arch (or
+# CUO_ARCH) when cross-building. arm64 is the fallback when the machine cannot
+# be identified.
+#
+#   bash build-naot.sh --arch x64
+#
+detect_arch() {
+  case "$(uname -m)" in
+    arm64|aarch64) echo arm64 ;;
+    x86_64|amd64)  echo x64 ;;
+    *)             echo arm64 ;;
+  esac
+}
+
+arch="${CUO_ARCH:-$(detect_arch)}"
+version=""
+dev_build=0
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --arch) arch="$2"; shift 2 ;;
+    --out) output_directory="$2"; shift 2 ;;
+    --version) version="$2"; shift 2 ;;
+    --dev-build) dev_build=1; shift ;;
+    *) echo "unknown option: $1"; exit 1 ;;
+  esac
+done
+
+# Extra properties, so a release build can stamp its version the way the
+# workflow in .github does.
+publish_props=()
+
+if [[ -n "$version" ]]; then
+  publish_props+=("-p:AssemblyVersion=$version" "-p:FileVersion=$version")
+fi
+
+client_props=("${publish_props[@]}")
+
+if [[ $dev_build -eq 1 ]]; then
+  client_props+=("-p:IS_DEV_BUILD=true")
+fi
+
+# Accept both spellings of each architecture.
+case $arch in
+  arm64|aarch64) arch="arm64" ;;
+  x64|x86_64|amd64) arch="x64" ;;
+  *) echo "Unsupported arch: $arch (use x64 or arm64)"; exit 1 ;;
+esac
+
 # Determine the platform
