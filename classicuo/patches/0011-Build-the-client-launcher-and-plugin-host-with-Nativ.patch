--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -36,10 +36,19 @@ jobs:
         include:
           - os: windows-latest
             target: win-x64
+            arch: x64
           - os: ubuntu-22.04
             target: linux-x64
+            arch: x64
           - os: macos-14
             target: osx-x64
+            arch: x86_64
+          - os: macos-14
+            target: osx-arm64
+            arch: arm64
+          - os: ubuntu-22.04-arm
+            target: linux-arm64
+            arch: arm64
 
     steps:
       - uses: actions/checkout@v4
@@ -57,7 +66,12 @@ jobs:
           include-prerelease: false
 
       - name: Build ClassicUO
-        run: dotnet publish "${{ env.CUO_PROJECT_PATH }}" -c Release -r "${{ matrix.target }}" -o "${{ env.CUO_OUTPUT_PATH }}" /p:IS_DEV_BUILD=true /p:AssemblyVersion=${{ env.CUO_ASSEMBLY_VERSION }} /p:FileVersion=${{ env.CUO_ASSEMBLY_VERSION }} /p:NativeLib=Shared /p:OutputType=Library
+        run: >
+          bash scripts/build.sh
+          --arch ${{ matrix.arch }}
+          --out "${{ env.CUO_OUTPUT_PATH }}"
+          --version ${{ env.CUO_ASSEMBLY_VERSION }}
+          --dev-build
 
       - name: upload-unsigned-artifact
         if: matrix.os == 'windows-latest'
