+
+# An intermediate build left from the plugin-host days (the client as a shared
+# library) goes stale in ways MSBuild does not notice, since no source changed:
+# publishing then fails on the ILC step.
+rm -rf "$root_dir/src/ClassicUO.Client/obj/Release/net10.0/$target"
