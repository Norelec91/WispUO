+# ARM64 build, the others would have to be compiled by hand.
+case $platform in
+  MINGW* | CYGWIN* | MSYS*)
+    if [[ "$arch" == "arm64" ]]; then
+      echo "win-arm64 is not supported: FNA3D, FAudio and theorafile have no ARM64"
+      echo "builds. Use --arch x64, which runs under emulation on an ARM machine."
