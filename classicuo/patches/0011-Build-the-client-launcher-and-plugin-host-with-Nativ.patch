+# bin/dist is incremental, so a build for another architecture would leave a
+# payload mixing the two. Drop what belongs to an architecture when it changes,
+# keeping settings and profiles if the folder has been played from.
+marker="$output_directory/.build-target"
+
+if [[ -f "$marker" && "$(cat "$marker")" != "$target" ]]; then
+  echo "Target changed ($(cat "$marker") -> $target), clearing the old payload."
+
+  rm -rf "$output_directory"/cuo "$output_directory"/cuo.dSYM \
+         "$output_directory"/ClassicUOLauncher \
+         "$output_directory"/*.dylib "$output_directory"/*.so*
+fi
+
+dotnet publish "$client_project" -c Release -r $target -o "$output_directory" "${client_props[@]}"
+dotnet publish "$launcher_project" -c Release -r $target -o "$output_directory" "${publish_props[@]}"
+
+# Managed plugins run on the .NET runtime the client starts through hostfxr
+# (CoreClrPluginHost.cs). The host is plain IL, the same file on every platform.
+dotnet publish "$plugin_host_project" -c Release -o "$output_directory" "${publish_props[@]}"
+
+strip_old_plugin_host
+write_launcher
+chmod_outputs
 
