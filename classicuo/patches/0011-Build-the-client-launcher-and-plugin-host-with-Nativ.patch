+# ./ClassicUO opens the launcher, which shows the shard list and then replaces
+# itself with the client. Arguments skip the window and go straight to the client.
+write_launcher() {
+  case $platform in
+    MINGW* | CYGWIN* | MSYS*) return ;;
+  esac
+
+  cat > "$output_directory/ClassicUO" <<LAUNCHER
+#!/bin/bash
+cd "\$(cd -P -- "\$(dirname -- "\$0")" && pwd -P)"
+exec ./ClassicUOLauncher "\$@"
+LAUNCHER
+}
+
+# Earlier builds carried another plugin host: a bootstrap, a Mono host with its class
+# libraries, and the client as a library. bin/dist is incremental and may hold
+# user data, so remove what is left of it rather than wiping the folder.
+strip_old_plugin_host() {
+  rm -rf "$output_directory"/cuo.dylib "$output_directory"/cuo.dylib.dSYM \
+         "$output_directory"/cuo.dll "$output_directory"/cuo.so "$output_directory"/cuo.so.dbg
+
+  rm -f "$output_directory"/ClassicUO.bin.* \
+        "$output_directory"/ClassicUO.exe \
+        "$output_directory"/ClassicUO.exe.config \
+        "$output_directory"/ClassicUO.pdb \
+        "$output_directory"/monoconfig \
+        "$output_directory"/monomachineconfig
+
+  local name
+  for name in Accessibility Microsoft.CSharp Mono.Posix Mono.Security mscorlib netstandard \
+              System System.Buffers System.Configuration System.Core System.Data System.Drawing \
+              System.IO.Compression System.IO.Compression.FileSystem System.Memory System.Numerics \
+              System.Numerics.Vectors System.Runtime.CompilerServices.Unsafe \
+              System.Runtime.Serialization System.Security System.ValueTuple System.Windows.Forms \
+              System.Xml System.Xml.Linq; do
+    rm -f "$output_directory/$name.dll"
+  done
+}
+
+chmod_outputs() {
+  # The launcher script is generated here, and a copy can lose the executable
+  # bit (a zip round trip, a checkout on Windows, an MSBuild Copy that does not
+  # preserve modes). Set it here so bin/dist is runnable no matter how it got there.
+  case $platform in
+    MINGW* | CYGWIN* | MSYS*) return ;;
+  esac
+
+  # Written as an if, not as "[[ -f ]] && chmod": an unmatched glob makes the
+  # test fail, and a false test as the last statement of a function returns
+  # non-zero, which under set -e kills the script right here.
+  for f in "$output_directory"/ClassicUO "$output_directory"/ClassicUOLauncher "$output_directory"/cuo; do
+    if [[ -f "$f" ]]; then
+      chmod +x "$f"
+    fi
+  done
