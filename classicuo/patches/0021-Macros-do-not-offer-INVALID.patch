From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alessandro Lopez <norelec@gmail.com>
Date: Tue, 6 Oct 2026 09:04:30 +0200
Subject: [PATCH] Macros: do not offer INVALID

It only keeps the numbers of the macros after it. The editor maps list positions
to macro numbers instead of using one for the other, so saved macros keep their
meaning.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LFcBNQtF3Z7vfzi99BXwUe
---
 src/ClassicUO.Client/Game/UI/Controls/MacroControl.cs | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/src/ClassicUO.Client/Game/UI/Controls/MacroControl.cs b/src/ClassicUO.Client/Game/UI/Controls/MacroControl.cs
index 489a2408c..959c4d8df 100644
--- a/src/ClassicUO.Client/Game/UI/Controls/MacroControl.cs
+++ b/src/ClassicUO.Client/Game/UI/Controls/MacroControl.cs
@@ -15,7 +15,6 @@ namespace ClassicUO.Game.UI.Controls
 {
     internal partial class MacroControl : Control
     {
-        private static readonly string[] _allHotkeysNames = Enum.GetNames(typeof(MacroType));
         private static readonly string[] _allSubHotkeysNames = Enum.GetNames(typeof(MacroSubType));
         private readonly DataBox _databox;
         private readonly HotkeyBox _hotkeyBox;
@@ -378,7 +377,7 @@ namespace ClassicUO.Game.UI.Controls
                     0,
                     200,
                     _items,
-                    (int) obj.Code
+                    Math.Max(0, Array.IndexOf(_allHotkeys, obj.Code))
                 )
                 {
                     Tag = obj
@@ -510,7 +509,7 @@ namespace ClassicUO.Game.UI.Controls
                 }
                 else
                 {
-                    MacroObject newMacroObj = Macro.Create((MacroType) e);
+                    MacroObject newMacroObj = Macro.Create(_allHotkeys[e]);
 
                     _control.Macro.Insert(currentMacroObj, newMacroObj);
                     _control.Macro.Remove(currentMacroObj);
